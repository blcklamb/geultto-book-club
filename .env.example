# 이 파일을 .env.local로 복사한 뒤 사용 환경의 값으로 채워주세요.
# 실제 키와 비밀 값이 들어간 .env.local은 커밋하지 마세요.
# Preview·Production에서는 배포 플랫폼의 환경 변수에 각각 설정해주세요.

# 필수: Supabase 프로젝트 URL과 공개용 publishable 키입니다.
# NEXT_PUBLIC_ 변수는 브라우저에 공개됩니다.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# 선택: 사이트 메타데이터와 로그인 후 돌아올 URL에 사용합니다.
# 로컬 개발은 아래 값을 사용하고, 배포 환경에서는 실제 사이트 URL로 바꿔주세요.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 이미지 첨부·삭제·정리에 필수인 서버 전용 service-role 키입니다.
# 위 Supabase URL과 동일한 프로젝트의 키를 입력해주세요.
# NEXT_PUBLIC_ 접두사를 붙이거나 브라우저 코드에서 사용하지 마세요.
SUPABASE_SERVICE_ROLE_KEY=

# 이미지 정기 정리 작업에 필수인 서버 전용 비밀 값입니다.
# 충분히 긴 무작위 값을 생성해 입력해주세요. 예: openssl rand -hex 32
# Vercel Cron은 이 값을 Authorization: Bearer <CRON_SECRET>으로 전달합니다.
# 로컬에서 정리 API를 호출할 때도 같은 헤더를 보내주세요.
CRON_SECRET=

# NODE_ENV는 Next.js가 실행 명령에 따라 설정하므로 직접 지정하지 않습니다.
# 이미지 첨부는 환경 변수 설정과 함께 DB 마이그레이션 적용이 필요합니다.
# 자세한 배포 절차: docs/image-attachments-deployment.md
